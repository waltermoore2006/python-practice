username = input("enter a username: ")

def username_check(username):
  has_number = False
  no_space = False
  correct_length = False

  for char in username:
    if char.isdigit():
      has_number = True

  if " " in username:
    no_space = False
  else:
    no_space = True

  if len(username) >= 5 and len(username) <= 12:
    correct_length = True

  if has_number and no_space and correct_length:
    return True
  else:
    return False


if username_check(username):
  print("your username is good")
else:
  print("your username is bad")


